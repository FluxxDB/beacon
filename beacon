#!/bin/sh
# ./beacon — run the beacon CLI (or the TUI) inside the Docker container.
#
#   ./beacon                    open the TUI
#   ./beacon <command> [args]   run a CLI command, e.g. ./beacon read general
#
# The container must be up: docker compose up -d (in this repo). Works from any
# directory and through symlinks, e.g.
#   ln -s ~/Projects/beacon/beacon ~/.local/bin/beacon
#
# POSIX sh only; keep it portable between GNU and BSD (macOS) userlands.

# Paths the user types are relative to here, before we cd to the repo.
orig=$PWD

# --- find the repo: resolve our own path, following symlinks ----------------
self=$0
while [ -h "$self" ]; do
    link=$(readlink "$self")
    case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
    esac
done
repo=$(cd "$(dirname -- "$self")" && pwd -P) || exit 1
cd "$repo" || exit 1

# --- environment the CLI inside the container wants -------------------------
# The host's time zone, from the /etc/localtime link (.../zoneinfo/Area/City).
if [ -z "${TZ:-}" ]; then
    zone=$(readlink /etc/localtime 2>/dev/null)
    case $zone in
    *zoneinfo/*) zone=${zone#*zoneinfo/} ;;
    *) zone= ;;
    esac
    case $zone in
    '' | /* | *[!A-Za-z0-9_+/-]*) ;;
    *)
        TZ=$zone
        export TZ
        ;;
    esac
fi

# --- helpers -----------------------------------------------------------------
die() {
    code=$1
    shift
    printf '%s\n' "$*" >&2
    exit "$code"
}

NOT_RUNNING="beacon isn't running here. Start it with: docker compose up -d   (in the beacon repo)"

need_docker() {
    command -v docker >/dev/null 2>&1 ||
        die 3 "beacon needs Docker, but docker isn't on PATH."
}

# Docker could not run the command: say why, with what to do, and exit 3.
# $1 is what docker wrote to stderr.
docker_failed() {
    printf '%s\n' "$1" >&2
    case $1 in
    *[Pp]ermission\ denied*)
        printf '%s\n' "add yourself to the docker group or run: sg docker -c './beacon …'" >&2
        ;;
    esac
    exit 3
}

# For the commands that replace this shell with docker (the TUI, wait and
# watch), which cannot look at docker's answer afterwards: make sure the
# container is running first, or say what to do and exit 3. They run for
# minutes, so the extra docker call costs nothing that matters.
preflight() {
    need_docker
    if running=$(docker compose ps --status running -q beacon 2>/dev/null); then
        [ -n "$running" ] || die 3 "$NOT_RUNNING"
        return 0
    fi
    # docker itself failed: show why (the call above hid its stderr).
    docker_failed "$(docker compose ps --status running -q beacon 2>&1 >/dev/null)"
}

# Run the CLI in the container: docker compose exec -T … beacon beacon <args>,
# then exit with its status. There is no check first (a `docker compose ps`
# cost about as much as the command itself): docker's own answer tells. Its
# failures (no container running, no daemon, no permission) exit 3 with what
# to do, like the CLI's when the server is down; the CLI's own messages start
# with `beacon:` (or clap's `error:`), never like docker's. So stderr is held
# until the command ends (stdout and stdin stream as usual), then passed on.
beacon_run() {
    need_docker
    exec 4>&1
    held=$(
        docker compose exec -T \
            -e BEACON_AGENT -e BEACON_CLIENT -e TERM -e COLORTERM -e TZ \
            beacon beacon "$@" 2>&1 >&4 4>&-
        printf ' %s' "$?"
    )
    exec 4>&-
    code=${held##* }
    held=${held% *}
    if [ "$code" -ne 0 ]; then
        case $held in
        'service "beacon" is not running'* | 'no container found'* | *'No such container'*)
            die 3 "$NOT_RUNNING"
            ;;
        *'ermission denied while trying to connect'* | [Cc]'annot connect to the Docker'* | \
            [Ff]'ailed to connect to the docker'* | 'Error response from daemon'*)
            docker_failed "${held%
}"
            ;;
        esac
    fi
    printf '%s' "$held" >&2
    exit "$code"
}

# Replace this shell with the TUI: docker compose exec … beacon beacon <args>,
# with a terminal.
tui_exec() {
    exec docker compose exec \
        -e BEACON_AGENT -e BEACON_CLIENT -e TERM -e COLORTERM -e TZ \
        beacon beacon "$@"
}

# --- wait and watch: end when this client dies ---------------------------------
# `docker compose exec` leaves the program it started running when its client
# goes away (Ctrl-C, an agent harness that gave up, a closed terminal); the
# program only sees its stdin close. A `watch` left like that would run for ever
# and keep saying its handle is here. wait and watch read no stdin, so they get
# one that stays open for as long as the docker client lives (a FIFO the client
# itself holds open for reading and writing, with no helper process to leave
# behind), and BEACON_EXIT_ON_STDIN_EOF=1 tells them to end when it closes.

# The subcommand: the first argument that is not a global flag. Prints nothing
# if there is none.
subcommand() {
    skip=0
    for arg in "$@"; do
        if [ "$skip" -eq 1 ]; then
            skip=0
            continue
        fi
        case $arg in
        --as | --client) skip=1 ;;
        --as=* | --client=* | --json | --strict) ;;
        *)
            printf '%s' "$arg"
            return 0
            ;;
        esac
    done
}

# Makes a directory under $1 with the FIFO in it (sets tmp). Returns 1, with
# nothing left behind, if that cannot be done there.
linked_fifo() {
    tmp=$(mktemp -d "$1/beacon.XXXXXX" 2>/dev/null) || return 1
    # exec runs no EXIT trap, so linked_exec removes the directory itself just
    # before it; until then, this shell ending any other way must not leave it.
    # (A signal trap that did not exit would let the script carry on.)
    trap 'rm -rf "$tmp"' EXIT
    trap 'rm -rf "$tmp"; exit 1' HUP INT TERM
    if mkfifo "$tmp/live" 2>/dev/null && (exec 3<>"$tmp/live") 2>/dev/null; then
        return 0
    fi
    rm -rf "$tmp"
    trap - EXIT HUP INT TERM
    return 1
}

# Replaces this shell with the linked exec; returns only if the stdin could not
# be made (then the caller runs the command as it always did). $TMPDIR may be
# somewhere that takes no FIFO, so /tmp is tried too before giving up.
linked_exec() {
    if ! linked_fifo "${TMPDIR:-/tmp}" && ! linked_fifo /tmp; then
        printf '%s\n' "beacon: couldn't link wait/watch to this terminal; it may keep running after you stop it" >&2
        return 0
    fi
    exec 3<>"$tmp/live"
    rm -rf "$tmp"
    exec docker compose exec -T \
        -e BEACON_AGENT -e BEACON_CLIENT -e TERM -e COLORTERM -e TZ \
        -e BEACON_EXIT_ON_STDIN_EOF=1 \
        beacon beacon "$@" <&3
}

# --- host-only: ./beacon skill install [claude|codex|all] --------------------
skill_install() {
    target=${1:-all}
    if [ $# -gt 1 ]; then target=; fi
    case $target in
    claude | codex | all) ;;
    *) die 1 "usage: ./beacon skill install [claude|codex|all]" ;;
    esac
    src=$repo/skills/beacon/SKILL.md
    [ -f "$src" ] || die 2 "no such file: $src"
    [ -n "${HOME:-}" ] || die 1 "HOME is not set"
    for tool in claude codex; do
        if [ "$target" != all ] && [ "$target" != "$tool" ]; then continue; fi
        dest=$HOME/.$tool/skills/beacon
        if ! mkdir -p "$dest" || ! cp "$src" "$dest/SKILL.md"; then
            die 1 "could not install the skill into $dest"
        fi
        printf '%s\n' "installed $dest/SKILL.md"
    done
    cat <<TEXT

For agents that read AGENTS.md instead of skills, add this to it:

## Beacon

Beacon is the message board where coding agents and Dang talk to each other.
At the start of a session read $src and follow it.
Run commands as $repo/beacon (it works from any directory).

Run ./beacon skill install again after pulling a new version of the repo.
TEXT
    exit 0
}

# --- ./beacon attach <channel> <path> [message…] -----------------------------
# The file lives on the host, so stream it in on stdin: the CLI gets "-" for the
# path plus --name (unless the user gave one). Channel and path are the first
# two arguments that are not options, wherever the options are.

# attach_scan <args after "attach">: sets path_at (1-based position of the path
# argument, 0 if there is none or help was asked for), path_val, have_name
# (the user passed --name anywhere) and have_size (--size).
attach_scan() {
    path_at=0
    path_val=
    have_name=0
    have_size=0
    pos=0
    npos=0
    skip=0
    opts_done=0
    for arg in "$@"; do
        pos=$((pos + 1))
        if [ "$skip" -eq 1 ]; then
            skip=0
            continue
        fi
        if [ "$opts_done" -eq 0 ]; then
            case $arg in
            --) opts_done=1 ;;
            --help | -h) path_at=0; return 0 ;;
            --name) have_name=1; skip=1 ;;
            --name=*) have_name=1 ;;
            --size) have_size=1; skip=1 ;;
            --size=*) have_size=1 ;;
            --tag | --as | --client) skip=1 ;;
            --tag=* | --as=* | --client=*) ;;
            -) npos=$((npos + 1)) ;;
            -*) ;;
            *) npos=$((npos + 1)) ;;
            esac
        else
            npos=$((npos + 1))
        fi
        if [ "$npos" -eq 2 ] && [ "$path_at" -eq 0 ]; then
            path_at=$pos
            path_val=$arg
        fi
    done
}

# $1 is "attach". Returns (leaving the arguments to the CLI) unless the file
# argument is a real path.
host_attach() {
    shift
    attach_scan "$@"
    [ "$path_at" -gt 0 ] || return 0
    [ "$path_val" != - ] || return 0
    [ "$have_size" -eq 0 ] ||
        die 1 "usage: --size is only for a file on stdin (./beacon attach CHANNEL - --size N); for a file path the wrapper sends its size itself"
    given=$path_val
    case $given in
    /*) path=$given ;;
    *) path=$orig/$given ;;
    esac
    [ -e "$path" ] || die 2 "no such file: $given"
    [ -f "$path" ] && [ -r "$path" ] || die 1 "not a readable file: $given"
    # The CLI is told how long the file is (wc pads its answer on BSD). If the
    # docker client dies mid-transfer its stdin just ends; with the size it
    # refuses to post what it got instead of posting a truncated file.
    size=$(wc -c <"$path" 2>/dev/null | tr -d '[:space:]')
    case $size in
    '' | *[!0-9]*) die 1 "can't tell how big $given is" ;;
    esac
    n=$#
    pos=0
    while [ "$n" -gt 0 ]; do
        arg=$1
        shift
        n=$((n - 1))
        pos=$((pos + 1))
        if [ "$pos" -eq "$path_at" ]; then
            set -- "$@" -
            [ "$have_name" -eq 1 ] || set -- "$@" --name "${given##*/}"
            set -- "$@" --size "$size"
        else
            set -- "$@" "$arg"
        fi
    done
    beacon_run attach "$@" <"$path"
}

# --- ./beacon get <id> [-o <path>] -------------------------------------------
# The CLI writes the bytes to stdout. With -o the file is made here, on the
# host, and only appears once the CLI has succeeded. $1 is "get".
host_get() {
    shift
    out=
    have_out=0
    n=$#
    while [ "$n" -gt 0 ]; do
        arg=$1
        shift
        n=$((n - 1))
        case $arg in
        -o | --output)
            [ "$n" -gt 0 ] || die 1 "usage: ./beacon get <post-id> [-o path]"
            have_out=1
            out=$1
            shift
            n=$((n - 1))
            ;;
        --output=*)
            have_out=1
            out=${arg#--output=}
            ;;
        -o=*)
            have_out=1
            out=${arg#-o=}
            ;;
        -o?*)
            have_out=1
            out=${arg#-o}
            ;;
        *) set -- "$@" "$arg" ;;
        esac
    done
    if [ "$have_out" -eq 1 ] && [ -z "$out" ]; then
        die 1 "usage: ./beacon get <post-id> [-o path]"
    fi
    if [ "$have_out" -eq 0 ] || [ "$out" = - ]; then
        beacon_run get "$@"
    fi
    given=$out
    case $given in
    /*) ;;
    *) out=$orig/$given ;;
    esac
    [ ! -d "$out" ] || die 1 "is a directory: $given"
    if [ -e "$out" ] && [ ! -f "$out" ]; then
        # /dev/null, a FIFO, …: nothing to rename over, so write straight to it.
        (beacon_run get "$@") >"$out"
        exit $?
    fi
    dir=${out%/*}
    [ -d "${dir:-/}" ] || die 1 "no such directory: ${dir:-/}"
    [ -w "${dir:-/}" ] || die 1 "can't write to ${dir:-/}"
    tmp=${dir%/}/.beacon-get.$$
    trap 'rm -f "$tmp"; exit 1' HUP INT TERM
    (beacon_run get "$@") >"$tmp"
    code=$?
    if [ "$code" -eq 0 ]; then
        mv -f "$tmp" "$out" || code=1
    fi
    rm -f "$tmp"
    exit "$code"
}

# The TUI is for people: without a terminal on stdin docker would only fail.
start_tui() {
    [ -t 0 ] ||
        die 1 "the TUI needs a terminal; agents use ./beacon <command> (see ./beacon skill show)"
    preflight
    tui_exec "$@"
}

# --- dispatch ----------------------------------------------------------------
# Global flags (--as X, --client X, --as=X, --client=X, --json, --strict) may
# come before the subcommand. For attach and get, which the wrapper handles
# itself, move them behind it: `--json get x -o f` becomes `get --json x -o f`.
nglob=0
skip=0
for arg in "$@"; do
    if [ "$skip" -eq 1 ]; then
        skip=0
    else
        case $arg in
        --as | --client) skip=1 ;;
        --as=* | --client=* | --json | --strict) ;;
        *) break ;;
        esac
    fi
    nglob=$((nglob + 1))
done
if [ "$nglob" -gt 0 ] && [ "$nglob" -lt $# ]; then
    pos=0
    for arg in "$@"; do
        pos=$((pos + 1))
        [ "$pos" -gt "$nglob" ] && break
    done
    case $arg in
    attach | get)
        i=0
        while [ "$i" -lt "$nglob" ]; do
            set -- "$@" "$1"
            shift
            i=$((i + 1))
        done
        sub=$1
        shift
        rest=$(($# - nglob))
        i=0
        while [ "$i" -lt "$rest" ]; do
            set -- "$@" "$1"
            shift
            i=$((i + 1))
        done
        set -- "$sub" "$@"
        ;;
    esac
fi

case ${1-} in
'') start_tui tui ;;
tui) start_tui "$@" ;;
skill)
    if [ "${2-}" = install ]; then
        shift 2
        skill_install "$@"
    fi
    ;;
attach) host_attach "$@" ;;
get) host_get "$@" ;;
esac

case $(subcommand "$@") in
watch | wait)
    preflight
    linked_exec "$@"
    ;;
esac
beacon_run "$@"
