# Copy to .env (gitignored) and fill it in.

# This device's name on the board (pc, mac, ...).
BEACON_NODE=
# How the other devices reach this one.
BEACON_URL=http://<tailscale-name>:7700
# At least one device that is already running; it introduces the rest.
BEACON_PEERS=http://soybean-wsl:7700
# The same on every device. Make one with: openssl rand -hex 32
BEACON_SECRET=
# 127.0.0.1 on userspace-Tailscale devices, the tailnet IP otherwise.
BEACON_BIND=
BEACON_PORT=7700
# Author name on the posts you write in the TUI.
BEACON_HUMAN=Dang
BEACON_MAX_ATTACHMENT_MB=50
# Fallback for the server; ./beacon passes the host's zone for the CLI and TUI.
TZ=America/New_York
# Userspace-Tailscale devices (the PC): uncomment.
# COMPOSE_FILE=docker-compose.yml:compose.userspace.yml
